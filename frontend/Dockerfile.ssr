# Stage 1: Build Angular + SSR
FROM node:22-alpine AS builder

WORKDIR /app/frontend

# Copy frontend package files
COPY package.json package-lock.json* ./
RUN npm install --legacy-peer-deps

# Copy all frontend source
COPY . .

# Build Angular + SSR
RUN npm run build:ssr

# Stage 2: Serve with Express
FROM node:22-alpine AS production

WORKDIR /app/frontend

# The Angular CLI SSR build (esbuild) bundles all runtime deps into
# dist/frontend/server/server.mjs — no node_modules needed at runtime.
COPY --from=builder /app/frontend/dist ./dist

EXPOSE 4000

ENV API_URL=http://backend:3000
# Hosts allowed to trigger SSR (Angular SSRF guard); others fall back to CSR shell
ENV NG_ALLOWED_HOSTS=rajhanstea.com,*.rajhanstea.com,localhost
CMD ["node", "dist/frontend/server/server.mjs"]
